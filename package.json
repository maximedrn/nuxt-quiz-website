    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.4",
    "fast-shuffle": "6.2.1",
    "ioredis": "5.11.1",
    "lucide-vue-next": "1.0.0",
    "nuxt": "4.4.8",
    "nuxt-auth-utils": "0.5.29",
    "ofetch": "1.5.1",
    "postgres": "3.4.9",
    "rate-limiter-flexible": "11.2.0",
    "reka-ui": "2.10.1",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "ts-pattern": "5.9.0",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.8.0",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0"
  },
  "description": "A Nuxt 3 website for a quiz application.",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.7",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint-plugin-jsdoc": "63.0.13",
    "globals": "17.7.0",
    "lefthook": "2.1.10",
    "prettier-plugin-jsdoc": "1.8.1",
    "shadcn-vue": "2.7.4",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.7"
  },
  "name": "quiz-nuxt-website",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "database:generate": "drizzle-kit generate",
    "database:migrate": "drizzle-kit migrate",
    "database:push": "drizzle-kit push",
    "database:studio": "drizzle-kit studio",
    "dependencies:install": "sfw bun install",
    "dependencies:update": "bunx npm-check-updates -u",
    "dev": "nuxt dev",
    "format": "biome format --write . && prettier --write .",
    "generate": "nuxt generate",
    "lint": "biome check . && eslint",
    "lint:fix": "biome check --write .",
    "postinstall": "nuxt prepare",
    "prepare": "lefthook install",
    "preview": "nuxt preview",
    "spellcheck": "cspell \"**\" --no-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p .nuxt/tsconfig.server.json",
    "typecheck:vue": "nuxt typecheck"
  },
  "type": "module"
}
