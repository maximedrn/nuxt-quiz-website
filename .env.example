# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local dev (see docker-compose.yml):
DATABASE_URL="postgres://quiz:quiz@localhost:5432/solidity_quiz"
# En prod : URL fournie par ton hébergeur (Neon, Supabase, Railway…), par ex.
# DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Backend de stockage : "postgres" (défaut) ou "blockchain".
STORAGE_DRIVER="postgres"

# Requis uniquement si STORAGE_DRIVER="blockchain" :
# RPC_URL="https://sepolia.base.org"
# CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
# SIGNER_PRIVATE_KEY="0x..."

# ─────────────────────────────────────────────────────────────────────────────
# Cache & sessions (Redis + BentoCache)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# Auth (sealed sessions, code 8 chiffres)
# ─────────────────────────────────────────────────────────────────────────────
# Mot de passe de chiffrement des sessions (min. 32 chars — openssl rand -base64 33).
NUXT_SESSION_PASSWORD="change-me-please-use-openssl-rand-base64-33"
# Pepper dédié pour l'HMAC de lookup du code (indépendant du mot de passe de session).
AUTH_LOOKUP_PEPPER="change-me-please-use-openssl-rand-base64-33-too"

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (par IP)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_POINTS="100"
RATE_LIMIT_DURATION="60"
# Plus strict sur /api/auth/* (anti-bruteforce du code).
AUTH_RATE_LIMIT_POINTS="5"
AUTH_RATE_LIMIT_DURATION="60"
# Trust X-Forwarded-For (only "true" behind a real reverse proxy / CDN).
TRUSTED_PROXY="false"
AUTH_RATE_LIMIT_DURATION="60"
