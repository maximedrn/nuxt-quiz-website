{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "recommended": true,
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "enabled": true,
      "quoteStyle": "double"
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.nuxt",
      "!**/.output",
      "!**/node_modules",
      "!**/dist",
      "!**/app/lib/database/migrations",
      "!**/public",
      ".prettierrc",
      ".prettierignore",
      ".editorconfig",
      ".eslintignore",
      ".gitignore",
      "package-lock.json"
    ]
  },
  "formatter": {
    "attributePosition": "multiline",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "trailingNewline": true,
    "useEditorconfig": false
  },
  "html": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    },
    "linter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "domains": {
      "vue": "all"
    },
    "enabled": true,
    "rules": {
      "a11y": "error",
      "complexity": {
        "noExcessiveLinesPerFunction": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useHookAtTopLevel": "off",
        "useQwikValidLexicalScope": "off"
      },
      "nursery": {
        "noRestrictedDependencies": "off",
        "useBaseline": "off",
        "useExplicitType": "off",
        "useThisInClassMethods": "off"
      },
      "performance": "error",
      "preset": "all",
      "security": "error",
      "style": {
        "noDefaultExport": "off",
        "noMagicNumbers": "off",
        "useNamingConvention": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": [
                  "camelCase",
                  "kebab-case",
                  "PascalCase",
                  "snake_case",
                  "export"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "nuxt.config.ts",
        "drizzle.config.ts",
        "vitest.config.ts",
        "eslint.config.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/lib/**",
        "src/server/**",
        "src/app/composables/**",
        "src/app/middleware/**",
        "src/app/app.vue"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off",
            "noUndeclaredVariables": "off",
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/lib/auth/auth.service.ts", "src/server/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
